# ==============================================================================
# MusicFlow Mobile - Local Environment & Secrets Configuration Template
# ==============================================================================
# Скопіюйте цей файл у `.env` для локальної розробки.
# Файл `.env` додано до .gitignore і він НІКОЛИ не потрапить у публічний Git/реліз.
# ==============================================================================

# IP або хост локального сервера тестування / телеметрії
# Для Android емулятора за замовчуванням: http://10.0.2.2:8080
# Для вашого фізичного пристрою у локальній Wi-Fi мережі: http://192.168.x.x:8080
DEV_SERVER_URL=http://localhost:8080

# Порт сервера
DEV_SERVER_PORT=8080
